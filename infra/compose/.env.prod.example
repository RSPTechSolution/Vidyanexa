# ---- copy to .env.prod and fill in. Never commit .env.prod. ----

# Where people open Vidyanexa, e.g. http://203.0.113.10 or https://eduvia.example.in (no trailing slash)
PUBLIC_URL=http://localhost
HTTP_PORT=80
# Set false ONLY for a trial over plain http on a server IP; real schools must use https.
COOKIE_SECURE=true

# Database passwords (long random strings): python -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# ---- API settings (read by the api container) ----
APP_NAME=Vidyanexa
ENVIRONMENT=production
DEBUG=false
JWT_SECRET_KEY=
# APP_URL, API_PUBLIC_URL and CORS_ORIGINS are set from PUBLIC_URL in docker-compose.prod.yml.

# Online fee payments: none (record fees at the counter) | test (simulated; staging only, refused in production)
PAYMENT_GATEWAY=none

# Email: console (log only) | brevo
EMAIL_PROVIDER=console
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM=no-reply@example.in
EMAIL_FROM_NAME=Vidyanexa

# SMS / WhatsApp: console (log only) | msg91 / twilio | meta
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Push notifications to the apps: console | fcm (needs FIREBASE_CREDENTIALS_FILE inside the container)
PUSH_PROVIDER=console

# AI assistant: rules (built-in questions) | gemini (needs GEMINI_API_KEY, from aistudio.google.com) | anthropic (needs ANTHROPIC_API_KEY)
AI_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=

# Backups: one a day into the api_storage volume, keeping the newest 14
BACKUP_DAILY=true
BACKUP_KEEP=14

# Google Analytics 4 for the public website (optional), e.g. G-XXXXXXXXXX
GA_ID=
# Search Console / Bing Webmaster ownership codes (the content="..." value of their meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# File storage: uploaded files in a private bucket (Cloudflare R2). See docs/DEPLOYMENT.md "File storage".
# Without these, files stay on the server's disk.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=vidyanexa-files
# S3_BACKUP_BUCKET=vidyanexa-backups
