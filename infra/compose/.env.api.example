# ---- copy to .env.api on the server and fill in. Never commit .env.api. Used by docker-compose.api.yml. ----
# Make each secret with:  openssl rand -hex 32

# The API's own address (point an A record at this server first) and the website's address. No trailing slash.
API_DOMAIN=apis.vidyanexa.com
APP_URL=https://www.vidyanexa.com

# Database passwords (long random strings)
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# Shared with the website (set the same WEB_PROXY_SECRET on Vercel): lets the API see each visitor's own address.
WEB_PROXY_SECRET=

APP_NAME=Vidyanexa
# staging while testing (the demo school can be loaded); production, with a fresh database, before real schools join.
ENVIRONMENT=staging
DEBUG=false
JWT_SECRET_KEY=

# Online fee payments: none (record fees at the counter) | test (simulated; staging only)
PAYMENT_GATEWAY=none

# Email through Brevo, from the domain authenticated in Brevo (Senders & Domains)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SMTP_LOGIN=
EMAIL_FROM=no-reply@vidyanexa.com
EMAIL_FROM_NAME=Vidyanexa

# SMS / WhatsApp: console (log only) | msg91 / twilio | meta
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console

# Push notifications to the apps: console | fcm (needs FIREBASE_CREDENTIALS_FILE inside the container)
PUSH_PROVIDER=console

# AI assistant: rules (built-in questions) | anthropic (needs ANTHROPIC_API_KEY)
AI_PROVIDER=rules
ANTHROPIC_API_KEY=

# Uploaded files in Cloudflare R2 (private buckets). Remove these lines to keep files on this server's disk instead.
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=vidyanexa-files
S3_BACKUP_BUCKET=vidyanexa-backups

# Backups: one a day (kept on this server and copied to S3_BACKUP_BUCKET), keeping the newest 14
BACKUP_DAILY=true
BACKUP_KEEP=14
